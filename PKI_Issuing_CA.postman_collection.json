							"raw": "{\n    \"csrPem\": \"-----BEGIN CERTIFICATE REQUEST-----\\nMIIBnTCCAQYCAQAwJjEkMCIGA1UEAwwbQ2xpZW50IEFwcGxpY2F0aW9uLE89SU5T\\nQSxDPUZSMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAyYt7oH7T2GEx\\nuZ4Xq4m+Fh4y5VqE2VnS4gJ7vC0N/W6k5p8Y5z9Y9X0w4q5h6G4q5h6G4q5h6G4q\\n5h6G4q5h6G4q5h6G4q5h6G4q5h6G4q5h6G4q5h6G4q5h6G4q5h6G4q5h6G4q5h6G\\n4q5h6G4q5h6G4q5h6G4q5h6G4q5h6G4q5h6G4q5h6G4q5h6G4q5h6G4q5h6G4q5h\\n6G4q5h6G4q5h6G4q5h6G4q5h6G4q5h6G4q5h6G4q5h6G4q5h6G4q5h6G4q5h6G4q\\n5wIDAQABoAAwDQYJKoZIhvcNAQELBQADggEBAKeB1z+K7j2GExuZ4Xq4m+Fh4y5V\\nqE2VnS4gJ7vC0N/W6k5p8Y5z9Y9X0w4q5h6G4q5h6G4q5h6G4q5h6G4q5h6G4q5h\\n6G4q5h6G4q5h6G4q5h6G4q5h6G4q5h6G4q5h6G4q5h6G4q5h6G4q5h6G4q5h6G4q\\n5h6G4q5h6G4q5h6G4q5h6G4q5h6G4q5h6G4q5h6G4q5h6G4q5h6G4q5h6G4q5h6G\\n4q5h6G4q5h6G4q5h6G4q5h6G4q5h6G4q5h6G4q5h6G4q5h6G4q5h6G4q5h6G4q5h\\n6G4=\\n-----END CERTIFICATE REQUEST-----\",\n    \"caSerialNumber\": \"{{intermediateCaSerial}}\",\n    \"profileName\": \"EndEntity\"\n}"
