		{
			"name": "CA Management",
			"item": [
				{
					"name": "Initialize Root CA",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.serialNumber) {",
									"    pm.globals.set(\"rootCaSerial\", jsonData.serialNumber);",
									"    console.log(\"Saved rootCaSerial:\", jsonData.serialNumber);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"subjectDN\": \"CN=Root CA,O=INSA,C=FR\",\n    \"keyType\": \"RSA\",\n    \"keySizeOrCurve\": 2048,\n    \"profileName\": \"RootCA\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/certificates/cas/root",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"certificates",
								"cas",
								"root"
							]
						}
					},
					"response": []
				},
				{
					"name": "Initialize Intermediate CA",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.serialNumber) {",
									"    pm.globals.set(\"intermediateCaSerial\", jsonData.serialNumber);",
									"    console.log(\"Saved intermediateCaSerial:\", jsonData.serialNumber);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"subjectDN\": \"CN=Sub CA 1,O=INSA,C=FR\",\n    \"parentSerialNumber\": \"{{rootCaSerial}}\",\n    \"keyType\": \"EC\",\n    \"keySizeOrCurve\": 256,\n    \"profileName\": \"SubCA\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/certificates/cas/intermediate",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"certificates",
								"cas",
								"intermediate"
							]
						}
					},
					"response": []
				}
			]
		},
