# ============================================================
# PKI Issuing CA Portal — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env or any file containing real secrets to git.
#
# Generate secrets with:
#   openssl rand -base64 32
# ============================================================

# --- JWT Signing Secret (REQUIRED) ---
JWT_SECRET=<replace-with-openssl-rand-base64-32>
JWT_EXPIRATION_MS=3600000

# --- Database Credentials (REQUIRED) ---
DB_URL=jdbc:mariadb://localhost:3306/pki_db
DB_USERNAME=<replace-with-db-username>
DB_PASSWORD=<replace-with-strong-db-password>
DB_ROOT_PASSWORD=<replace-with-strong-root-password>

# --- Private Key Encryption Key (REQUIRED) ---
PKI_DB_ENCRYPTION_KEY=<replace-with-openssl-rand-base64-32>

# --- Redis Cache (REQUIRED in Docker topology) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=<replace-with-strong-password>

# --- LDAP Directory Publishing (optional, default disabled) ---
LDAP_ENABLED=false
LDAP_URL=ldap://localhost:389
LDAP_BASE_DN=dc=example,dc=org
LDAP_BIND_DN=<cn=admin,dc=example,dc=org>
LDAP_BIND_PASSWORD=<replace-with-ldap-password>
LDAP_CERT_ATTR=cACertificate;binary
LDAP_CRL_ATTR=certificateRevocationList;binary

# --- CDP / AIA / OCSP URLs ---
PKI_CDP_URL=https://localhost/api/v1/ca
PKI_OCSP_URL=https://localhost/api/v1/ocsp
PKI_CA_ISSUER_URL=https://localhost/api/v1/certificates/

# --- OCSP Responder Tuning ---
PKI_OCSP_SIGNER_VALIDITY_DAYS=7
PKI_OCSP_RESPONSE_TTL_SECONDS=300
PKI_OCSP_SIGNER_CHECK_MS=86400000

# --- CRL Scheduling ---
# pki.crl.validity-hours=24
# pki.crl.expiration-buffer-hours=1
# pki.crl.regeneration-check-interval-ms=300000

# --- Hardware Security Module (HSM) ---
PKI_HSM_ENABLED=true
PKI_HSM_LIBRARY=/usr/lib/softhsm/libsofthsm2.so
PKI_HSM_SLOT=0
HSM_PIN=1234
HSM_SO_PIN=1234
